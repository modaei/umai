LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_BASE_URL=https://api.openai.com/v1
UMREPORTS_API_URL=http://127.0.0.1:50008/report/
MONITORING_DATA_API_URL=http://metrics1.ultimatesys.com/render
# Rod-pump health check model; reuses LLM_API_KEY and LLM_BASE_URL (e.g. OpenRouter).
ROD_PUMP_HEALTH_LLM_MODEL=anthropic/claude-opus-5.5
ROD_PUMP_HEALTH_LLM_EFFORT=medium
# Coordinates sent to the health-check LLM per curve (shape-preserving down-sampling).
ROD_PUMP_HEALTH_SURFACE_POINTS=60
ROD_PUMP_HEALTH_DOWNHOLE_POINTS=100
# Downhole classifier: a card whose class has not changed since the last LLM review, at or
# above this confidence, reuses that review. Empty model path sends every card to the LLM.
ROD_PUMP_HEALTH_CLASSIFIER_MODEL=models/rod_pump_downhole_classifier.joblib
ROD_PUMP_HEALTH_CLASSIFIER_MIN_CONFIDENCE=0.9
# Trained models, the live model pointer and the last training run (umai-card-classifier).
ROD_PUMP_HEALTH_CLASSIFIER_DIR=models/rod_pump_classifier
# Share of cards that could reuse a review but go to the LLM to audit the classifier.
ROD_PUMP_HEALTH_CLASSIFIER_AUDIT_RATE=0.05
# Days before a routine card gets a fresh LLM review anyway, and the effort used for it.
ROD_PUMP_HEALTH_LLM_REFRESH_DAYS=7
ROD_PUMP_HEALTH_ROUTINE_EFFORT=low
# Cards whose downhole load range is below this always go to the LLM (collapsed cards).
ROD_PUMP_HEALTH_MIN_DOWNHOLE_LOAD_RANGE_LB=3000

# Surface load check: compares the reviewed card's surface load range (peak minus minimum load)
# with the well's normal range. A collapse or load drop sends the card to the LLM and is shown in
# the Surface Dynographs section of the health page.
# Number of the well's most recent good (not collapsed) cards whose median load range is its normal.
ROD_PUMP_HEALTH_SURFACE_BASELINE_CARDS=10
# Only good cards from this many days before the reviewed card count toward the normal.
ROD_PUMP_HEALTH_SURFACE_BASELINE_DAYS=14
# Collapse: the load range is below this share of the normal range (0.5 = less than half).
ROD_PUMP_HEALTH_SURFACE_COLLAPSE_RATIO=0.5
# Load dropping: the load range is below this share of the normal range but not a collapse.
ROD_PUMP_HEALTH_SURFACE_WATCH_RATIO=0.8
# Collapse regardless of the normal range: a load range below this many pounds. 0 turns it off.
ROD_PUMP_HEALTH_SURFACE_LOW_LOAD_RANGE_LB=3000

ROD_PUMP_TIMEOUT_SECONDS=20
ROD_PUMP_MAX_DATA_POINTS=96
ROD_PUMP_BATCH_WORKERS=2
# Optional metadata JSON for the gated next-24-hour paraffin model.
ROD_PUMP_MODEL_METADATA=
UMREPORTS_TIMEOUT_SECONDS=30
MAX_REPORT_DAYS=366
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Archive DB options fall back to the operational DB when omitted.
DB_ARCHIVE_HOST=
DB_ARCHIVE_PORT=
DB_ARCHIVE_USERNAME=
DB_ARCHIVE_PASSWORD=
DB_ARCHIVE_DATABASE=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
OPERATIONAL_SQL_DB_USER=
OPERATIONAL_SQL_DB_PASSWORD=
OPERATIONAL_SQL_MAX_ROWS=100
OPERATIONAL_SQL_TIMEOUT_SECONDS=10
UMAI_CONVERSATION_HISTORY_LIMIT=20
UMAI_CONVERSATION_TTL_HOURS=168
UMAI_DAILY_USER_LIMIT_ENABLED=true
UMAI_DAILY_USER_LIMIT_REQUESTS=150
TIMEZONE=UTC
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_USER=ometrics
VECTOR_DB_PASSWORD=
VECTOR_DB_NAME=ometrics
VECTOR_DB_POOL_SIZE=5
VECTOR_DB_MAX_OVERFLOW=5
VECTOR_DB_POOL_TIMEOUT=15
VECTOR_DB_POOL_RECYCLE=1800
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
LOG_LEVEL=INFO
